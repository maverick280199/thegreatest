[{"start": 2.0799999999999996, "end": 2.72, "text": " Ritter memo mila.", "words": [{"w": " Ritter", "s": 2.0799999999999996, "e": 2.72}, {"w": " memo", "s": 2.72, "e": 2.72}, {"w": " mila.", "s": 2.72, "e": 2.72}]}, {"start": 2.72, "end": 3.66, "text": " Paisa doobega nahi.", "words": [{"w": " Paisa", "s": 2.72, "e": 2.94}, {"w": " doobega", "s": 2.94, "e": 3.42}, {"w": " nahi.", "s": 3.42, "e": 3.66}]}, {"start": 3.92, "end": 6.32, "text": " Kanoon ke hisaab se 2 lakh tak mil sakte hain.", "words": [{"w": " Kanoon", "s": 3.92, "e": 4.36}, {"w": " ke", "s": 4.36, "e": 4.48}, {"w": " hisaab", "s": 4.48, "e": 4.78}, {"w": " se", "s": 4.78, "e": 4.88}, {"w": " 2", "s": 4.88, "e": 5.2}, {"w": " lakh", "s": 5.2, "e": 5.48}, {"w": " tak", "s": 5.48, "e": 5.68}, {"w": " mil", "s": 5.68, "e": 5.86}, {"w": " sakte", "s": 5.86, "e": 6.16}, {"w": " hain.", "s": 6.16, "e": 6.32}]}, {"start": 6.58, "end": 8.34, "text": " Kaise? Hisaab samjhiye.", "words": [{"w": " Kaise?", "s": 6.58, "e": 7.1}, {"w": " Hisaab", "s": 7.46, "e": 7.94}, {"w": " samjhiye.", "s": 7.94, "e": 8.34}]}, {"start": 8.7, "end": 11.04, "text": " Kanoon ka Hisaab, episode ek.", "words": [{"w": " Kanoon", "s": 8.7, "e": 9.32}, {"w": " ka", "s": 9.32, "e": 9.46}, {"w": " Hisaab,", "s": 9.46, "e": 9.88}, {"w": " episode", "s": 10.02, "e": 10.4}, {"w": " ek.", "s": 10.4, "e": 11.04}]}, {"start": 12.62, "end": 15.94, "text": " Pehle ghadi. Bank se cheque wapas aaya.", "words": [{"w": " Pehle", "s": 12.62, "e": 13.26}, {"w": " ghadi.", "s": 13.26, "e": 13.9}, {"w": " Bank", "s": 14.32, "e": 14.76}, {"w": " se", "s": 14.76, "e": 15.0}, {"w": " cheque", "s": 15.0, "e": 15.28}, {"w": " wapas", "s": 15.28, "e": 15.72}, {"w": " aaya.", "s": 15.72, "e": 15.94}]}, {"start": 16.2, "end": 17.2, "text": " Ritter memo mila.", "words": [{"w": " Ritter", "s": 16.2, "e": 16.46}, {"w": " memo", "s": 16.46, "e": 16.84}, {"w": " mila.", "s": 16.84, "e": 17.2}]}, {"start": 17.82, "end": 19.66, "text": " 30 din ke andar legal notice beju.", "words": [{"w": " 30", "s": 17.82, "e": 18.04}, {"w": " din", "s": 18.04, "e": 18.28}, {"w": " ke", "s": 18.28, "e": 18.42}, {"w": " andar", "s": 18.42, "e": 18.58}, {"w": " legal", "s": 18.58, "e": 18.9}, {"w": " notice", "s": 18.9, "e": 19.24}, {"w": " beju.", "s": 19.24, "e": 19.66}]}, {"start": 19.66, "end": 23.58, "text": " Saamne wale ke paas paisa lotaane ke 15 din.", "words": [{"w": " Saamne", "s": 19.66, "e": 20.88}, {"w": " wale", "s": 20.88, "e": 21.22}, {"w": " ke", "s": 21.22, "e": 21.44}, {"w": " paas", "s": 21.44, "e": 21.78}, {"w": " paisa", "s": 21.78, "e": 22.16}, {"w": " lotaane", "s": 22.16, "e": 22.64}, {"w": " ke", "s": 22.64, "e": 22.84}, {"w": " 15", "s": 22.84, "e": 23.26}, {"w": " din.", "s": 23.26, "e": 23.58}]}, {"start": 24.3, "end": 24.92, "text": " Nahi lotaaya.", "words": [{"w": " Nahi", "s": 24.3, "e": 24.44}, {"w": " lotaaya.", "s": 24.44, "e": 24.92}]}, {"start": 25.42, "end": 27.9, "text": " Agale ek maheene me complaint file karo", "words": [{"w": " Agale", "s": 25.42, "e": 25.78}, {"w": " ek", "s": 25.78, "e": 26.12}, {"w": " maheene", "s": 26.12, "e": 26.6}, {"w": " me", "s": 26.6, "e": 26.76}, {"w": " complaint", "s": 26.76, "e": 27.14}, {"w": " file", "s": 27.14, "e": 27.54}, {"w": " karo", "s": 27.54, "e": 27.9}]}, {"start": 27.9, "end": 30.5, "text": " Section 138 and I add.", "words": [{"w": " Section", "s": 27.9, "e": 28.54}, {"w": " 138", "s": 28.54, "e": 29.68}, {"w": " and", "s": 29.68, "e": 29.96}, {"w": " I", "s": 29.96, "e": 30.16}, {"w": " add.", "s": 30.16, "e": 30.5}]}, {"start": 30.96, "end": 31.58, "text": " Yaad rakh ho.", "words": [{"w": " Yaad", "s": 30.96, "e": 31.24}, {"w": " rakh", "s": 31.24, "e": 31.42}, {"w": " ho.", "s": 31.42, "e": 31.58}]}, {"start": 31.96, "end": 33.36, "text": " 30, 15, 30.", "words": [{"w": " 30,", "s": 31.96, "e": 32.12}, {"w": " 15,", "s": 32.42, "e": 32.66}, {"w": " 30.", "s": 33.04, "e": 33.36}]}, {"start": 33.84, "end": 36.08, "text": " Deadline choo ki to case kamzor.", "words": [{"w": " Deadline", "s": 33.84, "e": 34.38}, {"w": " choo", "s": 34.38, "e": 34.72}, {"w": " ki", "s": 34.72, "e": 34.86}, {"w": " to", "s": 34.86, "e": 35.28}, {"w": " case", "s": 35.28, "e": 35.6}, {"w": " kamzor.", "s": 35.6, "e": 36.08}]}, {"start": 36.88, "end": 37.46, "text": " Ab paisa.", "words": [{"w": " Ab", "s": 36.88, "e": 37.02}, {"w": " paisa.", "s": 37.02, "e": 37.46}]}, {"start": 37.8, "end": 39.1, "text": " Case chalte chalte hi court", "words": [{"w": " Case", "s": 37.8, "e": 38.0}, {"w": " chalte", "s": 38.0, "e": 38.4}, {"w": " chalte", "s": 38.4, "e": 38.76}, {"w": " hi", "s": 38.76, "e": 38.92}, {"w": " court", "s": 38.92, "e": 39.1}]}, {"start": 39.1, "end": 41.96, "text": " 20% tak interim compensation dila sakta hain", "words": [{"w": " 20", "s": 39.1, "e": 39.4}, {"w": "%", "s": 39.4, "e": 39.72}, {"w": " tak", "s": 39.72, "e": 40.0}, {"w": " interim", "s": 40.0, "e": 40.34}, {"w": " compensation", "s": 40.34, "e": 40.96}, {"w": " dila", "s": 40.96, "e": 41.36}, {"w": " sakta", "s": 41.36, "e": 41.76}, {"w": " hain", "s": 41.76, "e": 41.96}]}, {"start": 41.96, "end": 44.44, "text": " Yaani, 1 lakh pe 20,000 tak.", "words": [{"w": " Yaani,", "s": 41.96, "e": 42.32}, {"w": " 1", "s": 42.8, "e": 43.14}, {"w": " lakh", "s": 43.14, "e": 43.34}, {"w": " pe", "s": 43.34, "e": 43.54}, {"w": " 20", "s": 43.54, "e": 43.84}, {"w": ",000", "s": 43.84, "e": 44.1}, {"w": " tak.", "s": 44.1, "e": 44.44}]}, {"start": 45.18, "end": 46.96, "text": " Which is Section 143A.", "words": [{"w": " Which", "s": 45.18, "e": 45.36}, {"w": " is", "s": 45.36, "e": 45.54}, {"w": " Section", "s": 45.54, "e": 45.82}, {"w": " 143A.", "s": 45.82, "e": 46.96}]}, {"start": 47.58, "end": 48.5, "text": " Conviction hoa.", "words": [{"w": " Conviction", "s": 47.58, "e": 48.12}, {"w": " hoa.", "s": 48.12, "e": 48.5}]}, {"start": 48.5, "end": 51.0, "text": " Fine cheque ko 2 guna tak", "words": [{"w": " Fine", "s": 48.5, "e": 49.28}, {"w": " cheque", "s": 49.28, "e"