ka", "s": 76.54, "e": 77.02}, {"w": " ho", "s": 77.02, "e": 77.2}, {"w": " ki", "s": 77.2, "e": 77.38}, {"w": " paisa", "s": 77.38, "e": 77.76}]}, {"start": 77.76, "end": 78.78, "text": " sachbe bakaya tha.", "words": [{"w": " sachbe", "s": 77.76, "e": 78.2}, {"w": " bakaya", "s": 78.2, "e": 78.6}, {"w": " tha.", "s": 78.6, "e": 78.78}]}, {"start": 79.32, "end": 81.08, "text": " Kanun ka hesaab saaf.", "words": [{"w": " Kanun", "s": 79.32, "e": 79.78}, {"w": " ka", "s": 79.78, "e": 80.06}, {"w": " hesaab", "s": 80.06, "e": 80.62}, {"w": " saaf.", "s": 80.62, "e": 81.08}]}, {"start": 81.22, "end": 83.52, "text": " Deadline pakolo saboot rakho.", "words": [{"w": " Deadline", "s": 81.22, "e": 81.82}, {"w": " pakolo", "s": 81.82, "e": 82.24}, {"w": " saboot", "s": 82.24, "e": 83.12}, {"w": " rakho.", "s": 83.12, "e": 83.52}]}, {"start": 84.0, "end": 86.02, "text": " Kisi ka cheque aap ke paas pada hain.", "words": [{"w": " Kisi", "s": 84.0, "e": 84.24}, {"w": " ka", "s": 84.24, "e": 84.36}, {"w": " cheque", "s": 84.36, "e": 84.6}, {"w": " aap", "s": 84.6, "e": 84.78}, {"w": " ke", "s": 84.78, "e": 84.86}, {"w": " paas", "s": 84.86, "e": 85.12}, {"w": " pada", "s": 85.12, "e": 85.32}, {"w": " hain.", "s": 85.32, "e": 86.02}]}, {"start": 86.08, "end": 87.32, "text": " Os dost ko aereel bejo", "words": [{"w": " Os", "s": 86.08, "e": 86.2}, {"w": " dost", "s": 86.2, "e": 86.5}, {"w": " ko", "s": 86.5, "e": 86.72}, {"w": " aereel", "s": 86.72, "e": 87.06}, {"w": " bejo", "s": 87.06, "e": 87.32}]}, {"start": 87.92, "end": 90.26, "text": " Agala hesaab property me kisko kitna hain.", "words": [{"w": " Agala", "s": 87.84, "e": 88.14}, {"w": " hesaab", "s": 88.14, "e": 88.6}, {"w": " property", "s": 88.6, "e": 88.9}, {"w": " me", "s": 88.9, "e": 89.3}, {"w": " kisko", "s": 89.3, "e": 89.72}, {"w": " kitna", "s": 89.72, "e": 90.02}, {"w": " hain.", "s": 90.02, "e": 90.26}]}]